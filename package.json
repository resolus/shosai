{
  "name": "shosai",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify --define __RELEASE__:\\\"$(TZ=Asia/Tokyo date +%Y%m%d%H%M%S)\\\"",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply shosai-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply shosai-db --remote",
    "build:css": "tailwindcss -i ./src/style.css -o ./public/static/style.css --minify"
  },
  "dependencies": {
    "@hono/oauth-providers": "^0.9.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.0"
  }
}
